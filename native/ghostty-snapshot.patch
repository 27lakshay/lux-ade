+test "ADE local font cache matches shared lookups and survives grid replacement" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var lib = try Library.init(alloc);
+    defer lib.deinit();
+    var grid = try testGrid(.normal, alloc, lib);
+    const old_id = grid.cache_id;
+    _ = try grid.getIndex(alloc, 'A', .regular, null);
+    grid.deinit(alloc);
+    // Reuse exactly the same address; lifetime identity must reject TLS hits.
+    grid = try testGrid(.normal, alloc, lib);
+    defer grid.deinit(alloc);
+    try testing.expect(grid.cache_id != old_id);
+    _ = try grid.getIndex(alloc, 'A', .regular, null);
+    try testing.expect(grid.codepoints.count() > 0);
+    // Colliding direct-map slots, styles, missing codepoints, and repeated hits.
+    for ([_]u32{ 'A', 'A' + 256, 0x10ffff, 'A' }) |cp| {
+        for ([_]Style{ .regular, .bold }) |style| {
+            const expected = try grid.getIndexShared(alloc, cp, style, null);
+            try testing.expectEqual(expected, try grid.getIndex(alloc, cp, style, null));
+            try testing.expectEqual(expected, try grid.getIndex(alloc, cp, style, null));
+        }
+    }
+    const idx = (try grid.getIndex(alloc, 'A', .regular, null)).?;
+    const face = try grid.resolver.collection.getFace(idx);
+    const glyph = face.glyphIndex('A').?;
+    const opts: RenderOptions = .{ .grid_metrics = grid.metrics };
+    const expected = try grid.renderGlyphShared(alloc, idx, glyph, opts);
+    try testing.expectEqualDeep(expected, try grid.renderGlyph(alloc, idx, glyph, opts));
+    try grid.atlas_grayscale.grow(alloc, grid.atlas_grayscale.size * 2);
+    try testing.expectEqualDeep(expected, try grid.renderGlyph(alloc, idx, glyph, opts));
