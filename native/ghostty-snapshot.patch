+// Opt-in prototype instrumentation. Apple's command-buffer timestamps measure
+// GPU execution, not CPU encoding, queue wait, or on-screen presentation.
+const GpuBench = struct {
+    extern "c" fn getenv([*:0]const u8) ?[*:0]const u8;
+    extern "c" fn fopen([*:0]const u8, [*:0]const u8) ?*anyopaque;
+    extern "c" fn fwrite([*]const u8, usize, usize, *anyopaque) usize;
+    extern "c" fn fclose(*anyopaque) c_int;
+    extern "c" fn atexit(*const fn () callconv(.c) void) c_int;
+    extern "c" fn CFAbsoluteTimeGetCurrent() f64;
+
+    var locked = std.atomic.Value(bool).init(false);
+    var initialized = false;
+    var destination: ?[*:0]const u8 = null;
+    var bins: [10001]u64 = @splat(0);
+    var valid: u64 = 0;
+    var invalid: u64 = 0;
+    var errors: u64 = 0;
+    var overflow: u64 = 0;
+    var maximum_ms: f64 = 0;
+    var last_write: f64 = 0;
+
+    fn lock() void {
+        while (locked.cmpxchgWeak(false, true, .acquire, .monotonic) != null)
+            std.atomic.spinLoopHint();
+    }
+    fn unlock() void {
+        locked.store(false, .release);
+    }
+
+    fn record(buffer: objc.Object, health: Health) void {
+        lock();
+        defer unlock();
+        if (!initialized) {
+            initialized = true;
+            destination = getenv("ADE_GPU_BENCH_LOG");
+            if (destination) |dest| {
+                if (dest[0] == 0) {
+                    destination = null;
+                    return;
+                }
+                _ = atexit(&atExit);
+            }
+        }
+        if (destination == null) return;
+        if (health == .unhealthy) {
+            errors += 1;
+            invalid += 1;
+        } else if (!buffer.msgSend(bool, objc.sel("respondsToSelector:"), .{objc.sel("GPUStartTime")}) or
+            !buffer.msgSend(bool, objc.sel("respondsToSelector:"), .{objc.sel("GPUEndTime")}))
+        {
+            invalid += 1;
+        } else {
+            const start = buffer.getProperty(f64, "GPUStartTime");
+            const end = buffer.getProperty(f64, "GPUEndTime");
+            if (start > 0 and end >= start and std.math.isFinite(start) and std.math.isFinite(end)) {
+                const ms = (end - start) * 1000;
+                valid += 1;
+                maximum_ms = @max(maximum_ms, ms);
+                if (ms > 100) {
+                    overflow += 1;
+                } else {
+                    const bin: usize = @intFromFloat(@ceil(ms * 100));
+                    bins[@min(bin, bins.len - 1)] += 1;
+                }
+            } else {
+                invalid += 1;
+            }
+        }
+        const now = CFAbsoluteTimeGetCurrent();
+        if (now - last_write >= 1) {
+            dump();
+            last_write = now;
+        }
+    }
+
+    fn percentile(percent: u64) f64 {
+        if (valid == 0) return 0;
+        const threshold = (valid * percent + 99) / 100;
+        var sum: u64 = 0;
+        for (bins, 0..) |count, i| {
+            sum += count;
+            if (sum >= threshold) return @as(f64, @floatFromInt(i)) / 100;
+        }
+        return maximum_ms; // Conservative upper bound for overflow bucket.
+    }
+
+    fn dump() void {
+        const dest = destination orelse return;
+        var storage: [1024]u8 = undefined;
+        const data = std.fmt.bufPrint(
+            &storage,
+            "{{\"metric\":\"ghostty_gpu_command_buffer_ms\",\"valid\":{d},\"invalid\":{d},\"errors\":{d},\"overflow_gt_100ms\":{d},\"bin_width_ms\":0.01,\"p50_upper_ms\":{d:.4},\"p95_upper_ms\":{d:.4},\"max_ms\":{d:.4}}}\n",
+            .{ valid, invalid, errors, overflow, percentile(50), percentile(95), maximum_ms },
+        ) catch return;
+        const file = fopen(dest, "w") orelse return;
+        defer _ = fclose(file);
+        _ = fwrite(data.ptr, 1, data.len, file);
+    }
+
+    fn atExit() callconv(.c) void {
+        lock();
+        defer unlock();
+        dump();
+    }
+};
