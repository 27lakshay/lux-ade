{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 3,
  "useInferencePlugins": false,
  "analytics": false,
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "all"
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/nx.json"
    ],
    "toolchain": [
      {
        "runtime": "node --version"
      },
      {
        "runtime": "pnpm --version"
      },
      {
        "runtime": "node -p \"process.platform + process.arch\""
      },
      {
        "env": "NODE_OPTIONS"
      },
      {
        "env": "NODE_ENV"
      }
    ],
    "production": ["default", "!{projectRoot}/**/*.md"],
    "desktopProduction": [
      "production",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/vitest.config.*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "toolchain"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        "toolchain",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        }
      ]
    },
    "test": {
      "cache": false
    }
  }
}
