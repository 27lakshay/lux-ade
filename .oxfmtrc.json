{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "pnpm-lock.yaml",
    "packages/contracts/src/generated/**",
    "packages/contracts/schema/**",
    ".scratch/**",
    "target/**",
    ".ade/**",
    "apps/desktop/components.json",
    ".agents/skills/shadcn/**",
    ".agents/skills/motion/**",
    "skills-lock.json",
    "apps/desktop/src/renderer/src/components/ui/**",
    "apps/desktop/src/renderer/src/hooks/**",
    "apps/desktop/src/renderer/src/lib/utils.ts",
    "apps/desktop/src/renderer/src/shadcn.css"
  ]
}
