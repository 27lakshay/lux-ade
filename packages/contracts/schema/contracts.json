      "properties": {
        "draft": {
          "$ref": "#/$defs/Draft"
        },
        "type": {
          "description": "The `draft` type tag.",
          "enum": [
            "draft"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "draft"
      ],
      "type": "object"
    },
    "DraftSaveRequest": {
