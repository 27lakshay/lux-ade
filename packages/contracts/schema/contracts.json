{
  "$defs": {
    "Account": {
      "description": "Profile-owned account metadata. Credentials remain with the native provider.",
      "properties": {
        "claude_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaudeIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "codex_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodexIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "native_home": {
          "type": "string"
        },
        "omp_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/OmpIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider",
        "name",
        "native_home",
        "generation",
        "state"
      ],
      "type": "object"
    },
    "AccountAck": {
      "description": "The `account.create` and `account.verify` reply.",
      "properties": {
        "account": {
          "$ref": "#/$defs/Account"
        },
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "account"
      ],
      "type": "object"
    },
    "AccountCreateRequest": {
      "additionalProperties": false,
      "description": "`account.create`: register a new native account home for a provider.",
      "properties": {
        "name": {
          "description": "Trimmed by the daemon; 1 to 80 characters without line breaks.",
          "type": "string"
        },
        "op": {
          "const": "account.create"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "provider",
        "name"
      ],
      "type": "object"
    },
    "AccountDisableRequest": {
      "additionalProperties": false,
      "description": "`account.disable`: stop new ADE launches with this account.",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "op": {
          "const": "account.disable"
        }
      },
      "required": [
        "op",
        "account_id"
      ],
      "type": "object"
    },
    "AccountDisabled": {
      "description": "The `account.disable` reply. ADE never logs the native CLI out.",
      "properties": {
        "account": {
          "$ref": "#/$defs/Account"
        },
        "native_logout": {
          "type": "boolean"
        },
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "account",
        "native_logout"
      ],
      "type": "object"
    },
    "AccountInspectRequest": {
      "additionalProperties": false,
      "description": "`account.inspect`: probe a managed account's native readiness.",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "op": {
          "const": "account.inspect"
        }
      },
      "required": [
        "op",
        "account_id"
      ],
      "type": "object"
    },
    "AccountInspection": {
      "description": "The `account.inspect` reply.",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "inspection": {
          "$ref": "#/$defs/Inspection"
        },
        "type": {
          "description": "The `account_inspection` type tag.",
          "enum": [
            "account_inspection"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "account_id",
        "generation",
        "inspection"
      ],
      "type": "object"
    },
    "AccountListRequest": {
      "additionalProperties": false,
      "description": "`account.list`: every account in the profile.",
      "properties": {
        "op": {
          "const": "account.list"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "AccountVerifyRequest": {
      "additionalProperties": false,
      "description": "`account.verify`: pin the identity an earlier `account.inspect` returned.",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "expected_generation": {
          "description": "The `generation` from `account.inspect`. Required on the wire; the\ndaemon reports its absence after it has found the account.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "expected_identity": {
          "description": "The `inspection.identity` object from `account.inspect`, as returned."
        },
        "op": {
          "const": "account.verify"
        }
      },
      "required": [
        "op",
        "account_id",
        "expected_generation",
        "expected_identity"
      ],
      "type": "object"
    },
    "AccountsReply": {
      "description": "The `account.list` reply.",
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/Account"
          },
          "type": "array"
        },
        "type": {
          "description": "The `accounts` type tag.",
          "enum": [
            "accounts"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "accounts"
      ],
      "type": "object"
    },
    "Ack": {
      "description": "A bare acceptance reply.",
      "properties": {
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "AgentAnswerRequest": {
      "additionalProperties": false,
      "description": "`agent.answer`: answer a pending provider request by its ID.",
      "properties": {
        "answers": {
          "description": "Structured answers; required by the `answer` decision."
        },
        "conversation_id": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "op": {
          "const": "agent.answer"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "AgentSendRequest": {
      "additionalProperties": false,
      "description": "`agent.send`: submit a prompt. `request_id` is the caller-owned operation ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "agent.send"
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "Attachment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size"
      ],
      "type": "object"
    },
    "CatalogFrame": {
      "description": "The `catalog.get` reply and the `catalog` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/Catalogue"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/Descriptor"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `catalog` type tag.",
          "enum": [
            "catalog"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "catalog",
        "providers",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "CatalogGetRequest": {
      "additionalProperties": false,
      "description": "`catalog.get`: read the profile's workspaces, conversations and windows.",
      "properties": {
        "op": {
          "const": "catalog.get"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "Catalogue": {
      "properties": {
        "conversations": {
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        },
        "windows": {
          "items": true,
          "type": "array"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces",
        "conversations",
        "windows"
      ],
      "type": "object"
    },
    "ClaudeIdentity": {
      "properties": {
        "api_provider": {
          "type": "string"
        },
        "auth_method": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "org_id": {
          "type": "string"
        }
      },
      "required": [
        "auth_method",
        "api_provider",
        "email",
        "org_id"
      ],
      "type": "object"
    },
    "CodexIdentity": {
      "properties": {
        "chatgpt_account_id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "chatgpt_account_id"
      ],
      "type": "object"
    },
    "Conversation": {
      "properties": {
        "account_context": {
          "default": "legacy_ambient",
          "type": "string"
        },
        "account_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "active_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_config": {
          "default": {
            "model": null,
            "permission_mode": "default",
            "setting_sources": []
          }
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_paused": {
          "default": false,
          "type": "boolean"
        },
        "runtime_cursor": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_submission": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "terminal_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "view_terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "view_terminal",
        "terminal_owner",
        "queue_paused",
        "runtime_run",
        "runtime_cursor",
        "runtime_submission",
        "id",
        "workspace_id",
        "title",
        "provider",
        "account_id",
        "account_context",
        "provider_config",
        "provider_thread_id",
        "status",
        "active_turn_id",
        "error",
        "updated_at"
      ],
      "type": "object"
    },
    "ConversationChanged": {
      "description": "The `conversation_changed` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_changed` type tag.",
          "enum": [
            "conversation_changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "ConversationGetRequest": {
      "additionalProperties": false,
      "description": "`conversation.get`: one page of a conversation's messages, newest first.",
      "properties": {
        "before": {
          "description": "Return messages with a sequence below this one.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "conversation_id": {
          "type": "string"
        },
        "limit": {
          "description": "Page size; the daemon uses 50 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "conversation.get"
        }
      },
      "required": [
        "op",
        "conversation_id"
      ],
      "type": "object"
    },
    "ConversationSnapshot": {
      "description": "The `conversation.get` reply.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_snapshot` type tag.",
          "enum": [
            "conversation_snapshot"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "Descriptor": {
      "description": "The daemon advertises the same contract it uses to validate configuration.\nClients consume descriptors; they do not infer support from a provider name.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "setting_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities",
        "permission_modes",
        "setting_sources"
      ],
      "type": "object"
    },
    "Inspection": {
      "description": "A provider's native readiness report for one account.",
      "properties": {
        "identity": {
          "description": "The provider-specific identity to pin; its shape depends on the provider."
        },
        "reason": {
          "type": "string"
        },
        "state": {
          "description": "`ready` when the account can be verified.",
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "version",
        "identity"
      ],
      "type": "object"
    },
    "Message": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "content": true,
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "provider_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_feedback": true,
        "role": {
          "type": "string"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "conversation_id",
        "role",
        "kind",
        "text",
        "status",
        "turn_id",
        "provider_item_id",
        "sequence"
      ],
      "type": "object"
    },
    "OmpIdentity": {
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_id": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "credential_type": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_key": {
          "type": "string"
        },
        "org_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "credential_id",
        "credential_type",
        "identity_key",
        "email",
        "account_id",
        "org_id"
      ],
      "type": "object"
    },
    "PendingRequest": {
      "properties": {
        "answer_attempt": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "answer_dispatched": {
          "default": false,
          "type": "boolean"
        },
        "answer_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true,
        "rpc_id": true,
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "run_id",
        "rpc_id",
        "method",
        "params",
        "status",
        "answer_dispatched",
        "answer_attempt"
      ],
      "type": "object"
    },
    "ProviderListRequest": {
      "additionalProperties": false,
      "description": "`provider.list`: the providers this daemon can launch.",
      "properties": {
        "op": {
          "const": "provider.list"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "ProvidersReply": {
      "description": "The `provider.list` reply.",
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/Descriptor"
          },
          "type": "array"
        },
        "type": {
          "description": "The `providers` type tag.",
          "enum": [
            "providers"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "providers"
      ],
      "type": "object"
    },
    "QueuedPrompt": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "text",
        "status"
      ],
      "type": "object"
    },
    "TerminalOwner": {
      "properties": {
        "runtime_instance": {
          "type": "string"
        },
        "terminal_id": {
          "type": "string"
        },
        "transfer_id": {
          "type": "string"
        }
      },
      "required": [
        "terminal_id",
        "transfer_id",
        "runtime_instance"
      ],
      "type": "object"
    },
    "WorkspaceRecord": {
      "properties": {
        "extra_terminals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "needs_rebind": {
          "default": false,
          "type": "boolean"
        },
        "repository_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        },
        "terminal_id": {
          "type": "string"
        },
        "worktree_lifecycle_needs_rebind": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "extra_terminals",
        "id",
        "repository_id",
        "root",
        "name",
        "terminal_id",
        "needs_rebind",
        "worktree_lifecycle_needs_rebind"
      ],
      "type": "object"
    }
  },
  "$id": "ade-contracts",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "frames": [
    {
      "domain": "workspaces",
