      "response": "DraftReply",
      "tier": "idempotent_command"
    },
    {
      "domain": "conversations",
      "name": "draft.send.abort",
      "request": "DraftSendAbortRequest",
      "response": "DraftReply",
      "tier": "idempotent_command"
    },
    {
      "domain": "conversations",
      "name": "queue.enqueue",
      "request": "QueueEnqueueRequest",
      "response": "Ack",
      "tier": "effect_command"
    },
    {
      "domain": "conversations",
      "name": "queue.cancel",
      "request": "QueueCancelRequest",
      "response": "Ack",
