      "required": [
        "op",
        "window"
      ],
      "type": "object"
    },
    "WorkspaceRecord": {
      "properties": {
        "extra_terminals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "needs_rebind": {
          "default": false,
