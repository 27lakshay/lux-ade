{
  "$defs": {
    "Ack": {
      "description": "A bare acceptance reply.",
      "properties": {
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "AgentAnswerRequest": {
      "additionalProperties": false,
      "description": "`agent.answer`: answer a pending provider request by its ID.",
      "properties": {
        "answers": {
          "description": "Structured answers; required by the `answer` decision."
        },
        "conversation_id": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "op": {
          "const": "agent.answer"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "AgentSendRequest": {
      "additionalProperties": false,
      "description": "`agent.send`: submit a prompt. `request_id` is the caller-owned operation ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "agent.send"
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "Attachment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size"
      ],
      "type": "object"
    },
    "AttachmentImportRequest": {
      "additionalProperties": false,
      "description": "`attachment.import`: attach a regular file that the daemon reads from disk.\n`request_id` becomes the attachment ID.",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "attachment.import"
        },
        "path": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "path",
        "conversation_id",
        "request_id"
      ],
      "type": "object"
    },
    "AttachmentInspectRequest": {
      "additionalProperties": false,
      "description": "`attachment.inspect`: read a live attachment's metadata and digest.",
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "attachment.inspect"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "attachment_id"
      ],
      "type": "object"
    },
    "AttachmentInspection": {
      "description": "The `attachment.inspect` reply.",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the payload.",
          "type": "string"
        },
        "type": {
          "description": "The `attachment_inspection` type tag.",
          "enum": [
            "attachment_inspection"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "attachment",
        "sha256"
      ],
      "type": "object"
    },
    "AttachmentPutRequest": {
      "additionalProperties": false,
      "description": "`attachment.put`: upload attachment bytes. `request_id` becomes the attachment ID.",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "data": {
          "description": "Standard base64 of the file bytes.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "op": {
          "const": "attachment.put"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "data",
        "name",
        "conversation_id",
        "request_id"
      ],
      "type": "object"
    },
    "AttachmentReclaim": {
      "description": "The `attachment.reclaim.apply` reply; `attachment` is the state after reclaim.",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/AttachmentReclaimPreview"
        },
        "filesystem_reclaimed_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "reclaimed_payload_bytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "scope": {
          "description": "The `explicit_single_attachment` type tag.",
          "enum": [
            "explicit_single_attachment"
          ],
          "type": "string"
        },
        "type": {
          "description": "The `attachment_reclaim` type tag.",
          "enum": [
            "attachment_reclaim"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "attachment",
        "reclaimed_payload_bytes",
        "filesystem_reclaimed_bytes",
        "scope"
      ],
      "type": "object"
    },
    "AttachmentReclaimApplyRequest": {
      "additionalProperties": false,
      "description": "`attachment.reclaim.apply`: discard one unreferenced attachment's payload.",
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "expected_generation": {
          "description": "The preview's `generation`; a changed attachment is refused.",
          "type": "string"
        },
        "op": {
          "const": "attachment.reclaim.apply"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "attachment_id",
        "expected_generation"
      ],
      "type": "object"
    },
    "AttachmentReclaimPreview": {
      "description": "One attachment's retention state and what protects it from reclaim.",
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "created_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "estimated_reusable_payload_bytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "generation": {
          "type": "string"
        },
        "payload_bytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "protected_by": {
          "description": "`message`, `draft`, `queued_prompt`, `send_intent` or `already_discarded`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reclaimable": {
          "type": "boolean"
        },
        "state": {
          "description": "`live` or `discarded`.",
          "type": "string"
        }
      },
      "required": [
        "attachment_id",
        "conversation_id",
        "generation",
        "state",
        "created_at",
        "payload_bytes",
        "estimated_reusable_payload_bytes",
        "protected_by",
        "reclaimable"
      ],
      "type": "object"
    },
    "AttachmentReclaimPreviewReply": {
      "description": "The `attachment.reclaim.preview` reply.",
      "properties": {
        "automatic_gc_eligible": {
          "description": "Always false: only an explicit reclaim frees an attachment.",
          "type": "boolean"
        },
        "client_held_uploads": {
          "description": "The `not_enumerated` type tag.",
          "enum": [
            "not_enumerated"
          ],
          "type": "string"
        },
        "filesystem_reclaimed_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "preview": {
          "$ref": "#/$defs/AttachmentReclaimPreview"
        },
        "scope": {
          "description": "The `explicit_single_attachment` type tag.",
          "enum": [
            "explicit_single_attachment"
          ],
          "type": "string"
        },
        "type": {
          "description": "The `attachment_reclaim_preview` type tag.",
          "enum": [
            "attachment_reclaim_preview"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "preview",
        "scope",
        "automatic_gc_eligible",
        "client_held_uploads",
        "filesystem_reclaimed_bytes"
      ],
      "type": "object"
    },
    "AttachmentReclaimPreviewRequest": {
      "additionalProperties": false,
      "description": "`attachment.reclaim.preview`: report what reclaiming one attachment would free.",
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "attachment.reclaim.preview"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "attachment_id"
      ],
      "type": "object"
    },
    "AttachmentReply": {
      "description": "The `attachment.put` and `attachment.import` reply.",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "type": {
          "description": "The `attachment` type tag.",
          "enum": [
            "attachment"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "attachment"
      ],
      "type": "object"
    },
    "CatalogFrame": {
      "description": "The `catalog.get` reply and the `catalog` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/Catalogue"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/Descriptor"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `catalog` type tag.",
          "enum": [
            "catalog"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "catalog",
        "providers",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "CatalogGetRequest": {
      "additionalProperties": false,
      "description": "`catalog.get`: read the profile's workspaces, conversations and windows.",
      "properties": {
        "op": {
          "const": "catalog.get"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "Catalogue": {
      "properties": {
        "conversations": {
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        },
        "windows": {
          "items": true,
          "type": "array"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces",
        "conversations",
        "windows"
      ],
      "type": "object"
    },
    "Conversation": {
      "properties": {
        "account_context": {
          "default": "legacy_ambient",
          "type": "string"
        },
        "account_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "active_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_config": {
          "default": {
            "model": null,
            "permission_mode": "default",
            "setting_sources": []
          }
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_paused": {
          "default": false,
          "type": "boolean"
        },
        "runtime_cursor": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_submission": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "terminal_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "view_terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "view_terminal",
        "terminal_owner",
        "queue_paused",
        "runtime_run",
        "runtime_cursor",
        "runtime_submission",
        "id",
        "workspace_id",
        "title",
        "provider",
        "account_id",
        "account_context",
        "provider_config",
        "provider_thread_id",
        "status",
        "active_turn_id",
        "error",
        "updated_at"
      ],
      "type": "object"
    },
    "ConversationChanged": {
      "description": "The `conversation_changed` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_changed` type tag.",
          "enum": [
            "conversation_changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "ConversationCreateRequest": {
      "additionalProperties": false,
      "description": "`conversation.create`: make a Conversation in a workspace.",
      "properties": {
        "account_id": {
          "description": "A managed account of the same provider.",
          "type": "string"
        },
        "op": {
          "const": "conversation.create"
        },
        "provider": {
          "description": "Provider ID; defaults to `codex`.",
          "type": "string"
        },
        "provider_config": {
          "description": "Provider settings; the daemon validates them for the provider."
        },
        "title": {
          "description": "Defaults to `New Conversation`; at most 256 bytes.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id"
      ],
      "type": "object"
    },
    "ConversationCreated": {
      "description": "The `conversation.create` reply: an `ack` carrying the new Conversation.",
      "properties": {
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation"
      ],
      "type": "object"
    },
    "ConversationGetRequest": {
      "additionalProperties": false,
      "description": "`conversation.get`: one page of a conversation's messages, newest first.",
      "properties": {
        "before": {
          "description": "Return messages with a sequence below this one.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "conversation_id": {
          "type": "string"
        },
        "limit": {
          "description": "Page size; the daemon uses 50 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "conversation.get"
        }
      },
      "required": [
        "op",
        "conversation_id"
      ],
      "type": "object"
    },
    "ConversationSnapshot": {
      "description": "The `conversation.get` reply.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_snapshot` type tag.",
          "enum": [
            "conversation_snapshot"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "Descriptor": {
      "description": "The daemon advertises the same contract it uses to validate configuration.\nClients consume descriptors; they do not infer support from a provider name.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "setting_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities",
        "permission_modes",
        "setting_sources"
      ],
      "type": "object"
    },
    "Draft": {
      "description": "The schema of [`Draft`], which the model defines without one.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "revision"
      ],
      "type": "object"
    },
    "DraftGetRequest": {
      "additionalProperties": false,
      "description": "`draft.get`: read one window's draft of a Conversation.",
