        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "draft.send.complete"
        },
        "request_id": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "window_id",
        "request_id"
      ],
      "type": "object"
    },
    "DraftSendGetRequest": {
      "additionalProperties": false,
      "description": "`draft.send.get`: read the window's unresolved send intent.",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "draft.send.get"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "window_id"
      ],
      "type": "object"
    },
    "DraftSendPrepareRequest": {
      "additionalProperties": false,
      "description": "`draft.send.prepare`: record the exact prompt and draft before dispatch.\n`request_id` is the send's ID and becomes the accepted message's ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "draft_text": {
          "type": "string"
        },
        "op": {
          "const": "draft.send.prepare"
        },
        "request_id": {
          "type": "string"
        },
        "review_anchor": {
          "description": "One review anchor; excludes `review_feedback`."
        },
        "review_feedback": {
          "description": "A review feedback batch; excludes `review_anchor`."
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "draft_text",
        "revision",
        "conversation_id",
        "window_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "Message": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "content": true,
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "provider_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_feedback": true,
        "role": {
          "type": "string"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "conversation_id",
        "role",
        "kind",
        "text",
        "status",
        "turn_id",
        "provider_item_id",
        "sequence"
      ],
      "type": "object"
    },
    "PendingRequest": {
      "properties": {
        "answer_attempt": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "answer_dispatched": {
          "default": false,
          "type": "boolean"
        },
        "answer_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true,
        "rpc_id": true,
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "run_id",
        "rpc_id",
        "method",
        "params",
        "status",
        "answer_dispatched",
        "answer_attempt"
      ],
      "type": "object"
    },
    "QueueCancelRequest": {
      "additionalProperties": false,
      "description": "`queue.cancel`: cancel a queued prompt that has not been submitted.",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "queue.cancel"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id"
      ],
      "type": "object"
    },
    "QueueEnqueueRequest": {
      "additionalProperties": false,
      "description": "`queue.enqueue`: queue a prompt. `request_id` becomes the queued prompt's ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "queue.enqueue"
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "QueuePauseRequest": {
      "additionalProperties": false,
      "description": "`queue.pause`: pause or resume a Conversation's prompt queue.",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "queue.pause"
        },
        "paused": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "paused"
      ],
      "type": "object"
    },
    "QueuedPrompt": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "text",
        "status"
      ],
      "type": "object"
    },
    "SendIntent": {
      "description": "A prompt recorded before dispatch, with the draft it came from.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "draft_revision": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "draft_text": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "review_anchor": {
          "description": "Null unless the send carries one review anchor."
        },
        "review_feedback": {
          "description": "Null unless the send carries a review feedback batch."
        },
        "state": {
          "description": "`pending`, `rejected`, `completed` or `aborted`.",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "conversation_id",
        "window_id",
        "draft_revision",
        "draft_text",
        "text",
        "attachments",
        "state",
        "review_anchor",
        "review_feedback"
      ],
      "type": "object"
    },
    "SendIntentPrepared": {
      "description": "The `draft.send.prepare` reply: the new or already recorded intent.",
      "properties": {
        "intent": {
          "$ref": "#/$defs/SendIntent"
        },
        "type": {
          "description": "The `send_intent` type tag.",
          "enum": [
            "send_intent"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "intent"
      ],
      "type": "object"
    },
    "SendIntentState": {
      "description": "The `draft.send.get` reply. `intent` is null when no send is unresolved.",
      "properties": {
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "restored_from_backup": {
          "description": "Whether the profile was restored from a backup, which holds its sends.",
          "type": "boolean"
        },
        "type": {
          "description": "The `send_intent` type tag.",
          "enum": [
            "send_intent"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "intent",
        "restored_from_backup"
      ],
      "type": "object"
    },
    "TerminalOwner": {
      "properties": {
        "runtime_instance": {
          "type": "string"
        },
