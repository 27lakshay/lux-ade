            "null"
          ]
        },
        "root": {
          "type": "string"
        },
        "terminal_id": {
          "type": "string"
        },
        "worktree_lifecycle_needs_rebind": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "extra_terminals",
        "id",
        "repository_id",
        "root",
        "name",
        "terminal_id",
        "needs_rebind",
        "worktree_lifecycle_needs_rebind"
      ],
      "type": "object"
    }
  },
  "$id": "ade-contracts",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "frames": [
    {
      "domain": "workspaces",
      "frame": "CatalogFrame",
