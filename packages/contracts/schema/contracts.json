{
  "$defs": {
    "Ack": {
      "description": "A bare acceptance reply.",
      "properties": {
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "AgentAnswerRequest": {
      "additionalProperties": false,
      "description": "`agent.answer`: answer a pending provider request by its ID.",
      "properties": {
        "answers": {
          "description": "Structured answers; required by the `answer` decision."
        },
        "conversation_id": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "op": {
          "const": "agent.answer"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "AgentSendRequest": {
      "additionalProperties": false,
      "description": "`agent.send`: submit a prompt. `request_id` is the caller-owned operation ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "agent.send"
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "Attachment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size"
      ],
      "type": "object"
    },
    "CatalogFrame": {
      "description": "The `catalog.get` reply and the `catalog` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/Catalogue"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/Descriptor"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `catalog` type tag.",
          "enum": [
            "catalog"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "catalog",
        "providers",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "CatalogGetRequest": {
      "additionalProperties": false,
      "description": "`catalog.get`: read the profile's workspaces, conversations and windows.",
      "properties": {
        "op": {
          "const": "catalog.get"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "Catalogue": {
      "properties": {
        "conversations": {
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        },
        "windows": {
          "items": true,
          "type": "array"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces",
        "conversations",
        "windows"
      ],
      "type": "object"
    },
    "Conversation": {
      "properties": {
        "account_context": {
          "default": "legacy_ambient",
          "type": "string"
        },
        "account_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "active_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_config": {
          "default": {
            "model": null,
            "permission_mode": "default",
            "setting_sources": []
          }
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_paused": {
          "default": false,
          "type": "boolean"
        },
        "runtime_cursor": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_submission": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "terminal_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "view_terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "view_terminal",
        "terminal_owner",
        "queue_paused",
        "runtime_run",
        "runtime_cursor",
        "runtime_submission",
        "id",
        "workspace_id",
        "title",
        "provider",
        "account_id",
        "account_context",
        "provider_config",
        "provider_thread_id",
        "status",
        "active_turn_id",
        "error",
        "updated_at"
      ],
      "type": "object"
    },
    "ConversationChanged": {
      "description": "The `conversation_changed` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_changed` type tag.",
          "enum": [
            "conversation_changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "ConversationGetRequest": {
      "additionalProperties": false,
      "description": "`conversation.get`: one page of a conversation's messages, newest first.",
      "properties": {
        "before": {
          "description": "Return messages with a sequence below this one.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "conversation_id": {
          "type": "string"
        },
        "limit": {
          "description": "Page size; the daemon uses 50 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "conversation.get"
        }
      },
      "required": [
        "op",
        "conversation_id"
      ],
      "type": "object"
    },
    "ConversationSnapshot": {
      "description": "The `conversation.get` reply.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_snapshot` type tag.",
          "enum": [
            "conversation_snapshot"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "Descriptor": {
      "description": "The daemon advertises the same contract it uses to validate configuration.\nClients consume descriptors; they do not infer support from a provider name.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "setting_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities",
        "permission_modes",
        "setting_sources"
      ],
      "type": "object"
    },
    "FileEntry": {
      "description": "One entry in a listing or search result.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "name": {
          "description": "Display name; a name that is not UTF-8 is shown lossily.",
          "type": "string"
        },
        "path": {
          "description": "Workspace-relative path. A non-UTF-8 component is encoded as U+E000\nfollowed by its unpadded URL-safe Base64 bytes.",
          "type": "string"
        },
        "size": {
          "description": "Byte size of a regular file; null for every other kind.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "path",
        "kind",
        "size"
      ],
      "type": "object"
    },
    "FileKind": {
      "description": "A directory entry's type, read without following symbolic links.",
      "enum": [
        "directory",
        "file",
        "symlink",
        "other"
      ],
      "type": "string"
    },
    "FileList": {
      "description": "The `file.list` reply.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "type": "array"
        },
        "incomplete": {
          "type": "boolean"
        },
        "next_cursor": {
          "description": "Null when the directory has no more entries.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "type": {
          "description": "The `file_list` type tag.",
          "enum": [
            "file_list"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "entries",
        "next_cursor",
        "incomplete"
      ],
      "type": "object"
    },
    "FileListRequest": {
      "additionalProperties": false,
      "description": "`file.list`: one page of a workspace directory.",
      "properties": {
        "cursor": {
          "description": "The `next_cursor` of the previous page for the same path.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Page size, 1 to 100; the daemon uses 100 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "file.list"
        },
        "path": {
          "description": "Workspace-relative directory; the workspace root when absent or empty.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id"
      ],
      "type": "object"
    },
    "FilePreview": {
      "description": "The `file.preview` reply. `text` carries `mime` and `text`; `image` carries\n`mime` and `bytes_base64`; `unsupported` carries neither.",
      "properties": {
        "bytes_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/PreviewKind"
        },
        "mime": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "size": {
          "description": "The file's byte size.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "description": "True when the file exceeds the 256 KiB preview limit.",
          "type": "boolean"
        },
        "type": {
          "description": "The `file_preview` type tag.",
          "enum": [
            "file_preview"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "kind",
        "size",
        "truncated"
      ],
      "type": "object"
    },
    "FilePreviewRequest": {
      "additionalProperties": false,
      "description": "`file.preview`: the bounded contents of one workspace file.",
      "properties": {
        "op": {
          "const": "file.preview"
        },
        "path": {
          "description": "Workspace-relative file path.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "path"
      ],
      "type": "object"
    },
    "FileSearch": {
      "description": "The `file.search` reply.",
      "properties": {
        "incomplete": {
          "description": "True when depth, path-length or directory limits cut the search short.",
          "type": "boolean"
        },
        "next_cursor": {
          "description": "Null when the search has finished.",
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "type": "array"
        },
        "type": {
          "description": "The `file_search` type tag.",
          "enum": [
            "file_search"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "results",
        "next_cursor",
        "incomplete"
      ],
      "type": "object"
    },
    "FileSearchRequest": {
      "additionalProperties": false,
      "description": "`file.search`: one page of entries whose name contains the query, ignoring case.",
      "properties": {
        "cursor": {
          "description": "The `next_cursor` of the previous page for the same query.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Page size, 1 to 100; the daemon uses 100 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "file.search"
        },
        "query": {
          "description": "1 to 256 bytes.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "query"
      ],
      "type": "object"
    },
    "Message": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "content": true,
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "provider_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_feedback": true,
        "role": {
          "type": "string"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "conversation_id",
        "role",
        "kind",
        "text",
        "status",
        "turn_id",
        "provider_item_id",
        "sequence"
      ],
      "type": "object"
    },
    "OutputCoverage": {
      "description": "How much of a run's output the durable spool holds and the reply returns.",
      "properties": {
        "captured_through_offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "produced_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputCoverageReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the status is `complete`."
        },
        "returned_start_offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/OutputCoverageStatus"
        }
      },
      "required": [
        "status",
        "reason",
        "produced_bytes",
        "captured_through_offset",
        "returned_start_offset"
      ],
      "type": "object"
    },
    "OutputCoverageReason": {
      "description": "Why output coverage is pending or incomplete.",
      "enum": [
        "capture_error",
        "durable_output_unavailable",
        "retention_overflow",
        "segment_gap",
        "process_running",
        "exit_unknown",
        "capture_gap",
        "tail_limited"
      ],
      "type": "string"
    },
    "OutputCoverageStatus": {
      "description": "Whether the returned output covers everything the run produced.",
      "enum": [
        "complete",
        "pending",
        "incomplete"
      ],
      "type": "string"
    },
    "PendingRequest": {
      "properties": {
        "answer_attempt": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "answer_dispatched": {
          "default": false,
          "type": "boolean"
        },
        "answer_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true,
        "rpc_id": true,
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "run_id",
        "rpc_id",
        "method",
        "params",
        "status",
        "answer_dispatched",
        "answer_attempt"
      ],
      "type": "object"
    },
    "PreviewKind": {
      "description": "How a preview presents the file.",
      "enum": [
        "text",
        "image",
        "unsupported"
      ],
      "type": "string"
    },
    "QueuedPrompt": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "text",
        "status"
      ],
      "type": "object"
    },
    "Script": {
      "description": "A configured workspace script, as `script.list` returns it.",
      "oneOf": [
        {
          "properties": {
            "command": {
              "type": "string"
            },
            "kind": {
              "const": "package_json",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "command"
          ],
          "type": "object"
        },
        {
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cwd": {
              "type": "string"
            },
            "kind": {
              "const": "ade_recipe",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "program": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "program",
            "args",
            "cwd"
          ],
          "type": "object"
        }
      ]
    },
    "ScriptInspectRequest": {
      "additionalProperties": false,
      "description": "`script.inspect`: one run's state and output tail.",
      "properties": {
        "op": {
          "const": "script.inspect"
        },
        "run_id": {
          "type": "string"
        },
        "tail_bytes": {
          "description": "Output tail size, 1 to 32768 bytes; the daemon uses 8192 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "run_id"
      ],
      "type": "object"
    },
    "ScriptInspection": {
      "description": "The `script.inspect` reply.",
      "properties": {
        "durable_output": {
          "description": "The durable spool tail, passed through unchanged."
        },
        "exit_status": {
          "description": "The runtime's exit outcome (`kind` is `success`, `failure`, `signaled`\nor `unknown`), present once the runtime reports one."
        },
        "metrics": {
          "description": "The runtime's terminal metrics, passed through unchanged."
        },
        "name": {
          "description": "The script name encoded in the run ID; empty if it does not parse.",
          "type": "string"
        },
        "output": {
          "description": "The runtime's live `terminal.tail` reply, passed through unchanged."
        },
        "output_coverage": {
          "$ref": "#/$defs/OutputCoverage"
