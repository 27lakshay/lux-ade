        },
        "request_id": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "window_id",
        "request_id"
      ],
      "type": "object"
    },
    "DraftSendCompleteRequest": {
      "additionalProperties": false,
      "description": "`draft.send.complete`: clear the draft once the prompt was accepted.",
