          "type": "string"
        },
        "transfer_id": {
          "type": "string"
        }
      },
      "required": [
        "terminal_id",
        "transfer_id",
        "runtime_instance"
      ],
      "type": "object"
    },
    "WindowCloseRequest": {
      "additionalProperties": false,
      "description": "`window.close`: forget a window's record, unless it is the last one.",
      "properties": {
