{
  "$defs": {
    "Ack": {
      "description": "A bare acceptance reply.",
      "properties": {
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "AgentAnswerRequest": {
      "additionalProperties": false,
      "description": "`agent.answer`: answer a pending provider request by its ID.",
      "properties": {
        "answers": {
          "description": "Structured answers; required by the `answer` decision."
        },
        "conversation_id": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "op": {
          "const": "agent.answer"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "AgentSendRequest": {
      "additionalProperties": false,
      "description": "`agent.send`: submit a prompt. `request_id` is the caller-owned operation ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "agent.send"
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "Attachment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size"
      ],
      "type": "object"
    },
    "BrowserCloseRequest": {
      "additionalProperties": false,
      "description": "`browser.close`: close an exact tab.",
      "properties": {
        "op": {
          "const": "browser.close"
        },
        "operation_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id",
        "operation_id",
        "tab_id"
      ],
      "type": "object"
    },
    "BrowserInspectRequest": {
      "additionalProperties": false,
      "description": "`browser.inspect`: inspect one exact tab.",
      "properties": {
        "op": {
          "const": "browser.inspect"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id",
        "tab_id"
      ],
      "type": "object"
    },
    "BrowserListRequest": {
      "additionalProperties": false,
      "description": "`browser.list`: list the tabs under one exact owner.",
      "properties": {
        "op": {
          "const": "browser.list"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id"
      ],
      "type": "object"
    },
    "BrowserMutation": {
      "description": "The `browser.open`, `browser.navigate` and `browser.close` reply, relayed\nfrom the owner. `payload_fingerprint` is the daemon's fingerprint of the\noperation, its profile, owner, tab and URL.",
      "properties": {
        "op": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "payload_fingerprint": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        },
        "type": {
          "description": "The `browser_mutation` type tag.",
          "enum": [
            "browser_mutation"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "profile_id",
        "owner_id",
        "request_id",
        "payload_fingerprint",
        "op",
        "tab_id"
      ],
      "type": "object"
    },
    "BrowserNavigateRequest": {
      "additionalProperties": false,
      "description": "`browser.navigate`: load a URL in an exact tab.",
      "properties": {
        "op": {
          "const": "browser.navigate"
        },
        "operation_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id",
        "operation_id",
        "tab_id",
        "url"
      ],
      "type": "object"
    },
    "BrowserOpenRequest": {
      "additionalProperties": false,
      "description": "`browser.open`: open a tab. `operation_id` is the caller-owned operation\nID; the daemon still accepts it as `request_id`.",
      "properties": {
        "op": {
          "const": "browser.open"
        },
        "operation_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "url": {
          "description": "An `http://` or `https://` URL of at most 8192 bytes.",
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id",
        "operation_id",
        "url"
      ],
      "type": "object"
    },
    "BrowserOperation": {
      "description": "The `browser.operation` reply: the daemon's receipt, or the owner's.",
      "properties": {
        "op": {
          "description": "The mutation's operation; only the owner's receipt carries it.",
          "type": [
            "string",
            "null"
          ]
        },
        "owner_id": {
          "type": "string"
        },
        "payload_fingerprint": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "result": {
          "description": "The completed mutation's reply. The daemon's receipt sends `null`\nbefore completion; the owner's omits it without a tab."
        },
        "state": {
          "$ref": "#/$defs/BrowserOperationState"
        },
        "type": {
          "description": "The `browser_operation` type tag.",
          "enum": [
            "browser_operation"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "profile_id",
        "owner_id",
        "request_id",
        "payload_fingerprint",
        "state"
      ],
      "type": "object"
    },
    "BrowserOperationRequest": {
      "additionalProperties": false,
      "description": "`browser.operation`: read a browser mutation's receipt by its operation ID.",
      "properties": {
        "op": {
          "const": "browser.operation"
        },
        "operation_id": {
          "type": "string"
        },
        "profile_id": {
          "description": "Defaults to this daemon's browser profile.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op",
        "operation_id"
      ],
      "type": "object"
    },
    "BrowserOperationState": {
      "description": "Where a browser mutation stands.",
      "oneOf": [
        {
          "enum": [
            "completed"
          ],
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "The daemon admitted the mutation and has no outcome yet.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The outcome was lost; inspect before another action.",
          "type": "string"
        }
      ]
    },
    "BrowserOwnerGetRequest": {
      "additionalProperties": false,
      "description": "`browser.owner.get`: read the live browser owner of a profile.",
      "properties": {
        "op": {
          "const": "browser.owner.get"
        },
        "profile_id": {
          "description": "Defaults to this daemon's browser profile.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "BrowserOwnerRegisterRequest": {
      "additionalProperties": false,
      "description": "`browser.owner.register`: name the Unix socket that owns the profile's browser.",
      "properties": {
        "op": {
          "const": "browser.owner.register"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "socket_path": {
          "description": "An absolute path to a private, owned Unix socket.",
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id",
        "socket_path"
      ],
      "type": "object"
    },
    "BrowserOwnerReleased": {
      "description": "The `browser.owner.unregister` reply.",
      "properties": {
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "profile_id",
        "owner_id"
      ],
      "type": "object"
    },
    "BrowserOwnerReply": {
      "description": "The `browser.owner.get` and `browser.owner.register` reply.",
      "properties": {
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "type": {
          "description": "The `browser_owner` type tag.",
          "enum": [
            "browser_owner"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "profile_id",
        "owner_id"
      ],
      "type": "object"
    },
    "BrowserOwnerUnregisterRequest": {
      "additionalProperties": false,
      "description": "`browser.owner.unregister`: release the owner registration.",
      "properties": {
        "op": {
          "const": "browser.owner.unregister"
        },
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "profile_id",
        "owner_id"
      ],
      "type": "object"
    },
    "BrowserTabRecord": {
      "description": "One browser tab as the owner reports it. The owner uses camelCase names.",
      "properties": {
        "error": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "loading": {
          "type": "boolean"
        },
        "observedUrl": {
          "type": "string"
        },
        "profileId": {
          "description": "The owner's browser storage profile.",
          "type": "string"
        },
        "requestedUrl": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "profileId",
        "requestedUrl",
        "observedUrl",
        "title",
        "loading",
        "error"
      ],
      "type": "object"
    },
    "BrowserTabReply": {
      "description": "The `browser.inspect` reply, relayed from the owner.",
      "properties": {
        "owner_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "tab": {
          "$ref": "#/$defs/BrowserTabRecord"
        },
        "tab_id": {
          "type": "string"
        },
        "type": {
          "description": "The `browser_tab` type tag.",
          "enum": [
            "browser_tab"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "profile_id",
        "owner_id",
        "tab_id",
        "tab"
      ],
      "type": "object"
    },
    "BrowserTabs": {
      "description": "The `browser.list` reply, relayed from the owner.",
      "properties": {
        "owner_id": {
          "type": "string"
        },
        "profileId": {
          "description": "The owner's browser storage profile.",
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "selectedId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabs": {
          "items": {
            "$ref": "#/$defs/BrowserTabRecord"
          },
          "type": "array"
        },
        "type": {
          "description": "The `browser_tabs` type tag.",
          "enum": [
            "browser_tabs"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "profile_id",
        "owner_id",
        "profileId",
        "selectedId",
        "tabs"
      ],
      "type": "object"
    },
    "CatalogFrame": {
      "description": "The `catalog.get` reply and the `catalog` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/Catalogue"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/Descriptor"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `catalog` type tag.",
          "enum": [
            "catalog"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "catalog",
        "providers",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "CatalogGetRequest": {
      "additionalProperties": false,
      "description": "`catalog.get`: read the profile's workspaces, conversations and windows.",
      "properties": {
        "op": {
          "const": "catalog.get"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "Catalogue": {
      "properties": {
        "conversations": {
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        },
        "windows": {
          "items": true,
          "type": "array"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces",
        "conversations",
        "windows"
      ],
      "type": "object"
    },
    "Conversation": {
      "properties": {
        "account_context": {
          "default": "legacy_ambient",
          "type": "string"
        },
        "account_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "active_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_config": {
          "default": {
            "model": null,
            "permission_mode": "default",
            "setting_sources": []
          }
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_paused": {
          "default": false,
          "type": "boolean"
        },
        "runtime_cursor": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_submission": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "terminal_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "view_terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "view_terminal",
        "terminal_owner",
        "queue_paused",
        "runtime_run",
        "runtime_cursor",
        "runtime_submission",
        "id",
        "workspace_id",
        "title",
        "provider",
        "account_id",
        "account_context",
        "provider_config",
        "provider_thread_id",
        "status",
        "active_turn_id",
        "error",
        "updated_at"
      ],
      "type": "object"
    },
    "ConversationChanged": {
      "description": "The `conversation_changed` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_changed` type tag.",
          "enum": [
            "conversation_changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "ConversationGetRequest": {
      "additionalProperties": false,
      "description": "`conversation.get`: one page of a conversation's messages, newest first.",
      "properties": {
        "before": {
          "description": "Return messages with a sequence below this one.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "conversation_id": {
          "type": "string"
        },
        "limit": {
          "description": "Page size; the daemon uses 50 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "conversation.get"
        }
      },
      "required": [
        "op",
        "conversation_id"
      ],
      "type": "object"
    },
    "ConversationSnapshot": {
      "description": "The `conversation.get` reply.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_snapshot` type tag.",
          "enum": [
            "conversation_snapshot"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "DaemonHello": {
      "description": "The `hello` reply: build identity and every protocol version.",
      "properties": {
        "application_protocol": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "build_id": {
          "description": "`ADE_BUILD_ID`, or `null` when the daemon was built without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "response_owner": {
          "type": "string"
        },
        "review_protocol": {
          "type": "string"
        },
        "runtime_instance": {
          "type": "string"
        },
        "runtime_pid": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_protocol": {
          "type": "string"
        },
        "runtime_socket": {
          "type": "string"
        },
        "session_protocol": {
          "type": "string"
        },
        "terminal_snapshot_format": {
          "type": "string"
        },
        "terminal_snapshot_formats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "description": "The `hello` type tag.",
          "enum": [
            "hello"
          ],
          "type": "string"
        },
        "worktree_protocol": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "build_id",
        "application_protocol",
        "runtime_protocol",
        "runtime_instance",
        "runtime_pid",
        "runtime_socket",
        "pid",
        "session_protocol",
        "worktree_protocol",
        "review_protocol",
        "response_owner",
        "terminal_snapshot_format",
        "terminal_snapshot_formats",
        "boot_id"
      ],
      "type": "object"
    },
    "Descriptor": {
      "description": "The daemon advertises the same contract it uses to validate configuration.\nClients consume descriptors; they do not infer support from a provider name.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "setting_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities",
        "permission_modes",
        "setting_sources"
      ],
      "type": "object"
    },
    "HelloRequest": {
      "additionalProperties": false,
