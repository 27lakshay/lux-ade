{
  "$defs": {
    "Ack": {
      "description": "A bare acceptance reply.",
      "properties": {
        "type": {
          "description": "The `ack` type tag.",
          "enum": [
            "ack"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "AgentAnswerRequest": {
      "additionalProperties": false,
      "description": "`agent.answer`: answer a pending provider request by its ID.",
      "properties": {
        "answers": {
          "description": "Structured answers; required by the `answer` decision."
        },
        "conversation_id": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "op": {
          "const": "agent.answer"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "AgentSendRequest": {
      "additionalProperties": false,
      "description": "`agent.send`: submit a prompt. `request_id` is the caller-owned operation ID.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "agent.send"
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "request_id",
        "text"
      ],
      "type": "object"
    },
    "Attachment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size"
      ],
      "type": "object"
    },
    "CatalogFrame": {
      "description": "The `catalog.get` reply and the `catalog` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/Catalogue"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/Descriptor"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `catalog` type tag.",
          "enum": [
            "catalog"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "catalog",
        "providers",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "CatalogGetRequest": {
      "additionalProperties": false,
      "description": "`catalog.get`: read the profile's workspaces, conversations and windows.",
      "properties": {
        "op": {
          "const": "catalog.get"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "Catalogue": {
      "properties": {
        "conversations": {
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        },
        "windows": {
          "items": true,
          "type": "array"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces",
        "conversations",
        "windows"
      ],
      "type": "object"
    },
    "Conversation": {
      "properties": {
        "account_context": {
          "default": "legacy_ambient",
          "type": "string"
        },
        "account_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "active_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_config": {
          "default": {
            "model": null,
            "permission_mode": "default",
            "setting_sources": []
          }
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_paused": {
          "default": false,
          "type": "boolean"
        },
        "runtime_cursor": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_run": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_submission": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "terminal_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "view_terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "view_terminal",
        "terminal_owner",
        "queue_paused",
        "runtime_run",
        "runtime_cursor",
        "runtime_submission",
        "id",
        "workspace_id",
        "title",
        "provider",
        "account_id",
        "account_context",
        "provider_config",
        "provider_thread_id",
        "status",
        "active_turn_id",
        "error",
        "updated_at"
      ],
      "type": "object"
    },
    "ConversationChanged": {
      "description": "The `conversation_changed` feed frame.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_changed` type tag.",
          "enum": [
            "conversation_changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "ConversationGetRequest": {
      "additionalProperties": false,
      "description": "`conversation.get`: one page of a conversation's messages, newest first.",
      "properties": {
        "before": {
          "description": "Return messages with a sequence below this one.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "conversation_id": {
          "type": "string"
        },
        "limit": {
          "description": "Page size; the daemon uses 50 when it is absent.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "conversation.get"
        }
      },
      "required": [
        "op",
        "conversation_id"
      ],
      "type": "object"
    },
    "ConversationSnapshot": {
      "description": "The `conversation.get` reply.",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "queued": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The `conversation_snapshot` type tag.",
          "enum": [
            "conversation_snapshot"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation",
        "messages",
        "requests",
        "queued",
        "boot_id",
        "revision"
      ],
      "type": "object"
    },
    "Descriptor": {
      "description": "The daemon advertises the same contract it uses to validate configuration.\nClients consume descriptors; they do not infer support from a provider name.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permission_modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "setting_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities",
        "permission_modes",
        "setting_sources"
      ],
      "type": "object"
    },
    "GitOperation": {
      "description": "A Git mutation's receipt.",
      "properties": {
        "backup_path": {
          "description": "Where a discard kept the displaced file.",
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "description": "The failure code; present and null on a failure without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "The caller's operation ID.",
          "type": "string"
        },
        "op": {
          "description": "The operation name, such as `review.stage`.",
          "type": "string"
        },
        "recovery": {
          "description": "The recovery hint; present and null on a failure without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "description": "The success result: `{head, output}` for a commit, otherwise\n`{changed, action, receipt}`."
        },
        "started_at": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/GitOperationStatus"
        }
      },
      "required": [
        "id",
        "status",
        "started_at",
        "op"
      ],
      "type": "object"
    },
    "GitOperationStatus": {
      "description": "Where a Git mutation stands.",
      "oneOf": [
        {
          "enum": [
            "running",
            "succeeded",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "The daemon stopped during the Git step; it will not run again.",
          "type": "string"
        }
      ]
    },
    "Message": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "content": true,
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "provider_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_feedback": true,
        "role": {
          "type": "string"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "conversation_id",
        "role",
        "kind",
        "text",
        "status",
        "turn_id",
        "provider_item_id",
        "sequence"
      ],
      "type": "object"
    },
    "PendingRequest": {
      "properties": {
        "answer_attempt": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "answer_dispatched": {
          "default": false,
          "type": "boolean"
        },
        "answer_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true,
        "rpc_id": true,
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "run_id",
        "rpc_id",
        "method",
        "params",
        "status",
        "answer_dispatched",
        "answer_attempt"
      ],
      "type": "object"
    },
    "QueuedPrompt": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "text",
        "status"
      ],
      "type": "object"
    },
    "ReviewCommitRequest": {
      "additionalProperties": false,
      "description": "`review.commit`: commit the reviewed staged index.",
      "properties": {
        "index_token": {
          "description": "The status `index_token` the user reviewed.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "op": {
          "const": "review.commit"
        },
        "operation_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "operation_id",
        "message",
        "index_token"
      ],
      "type": "object"
    },
    "ReviewDiff": {
      "description": "The `review.diff` reply.",
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "conflict": {
          "type": "boolean"
        },
        "header": {
          "type": "string"
        },
        "hunk_actions": {
          "description": "Whether single hunks can be staged; binary, mode, link and\nconflicted changes move only as whole files.",
          "type": "boolean"
        },
        "hunks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "staged": {
          "type": "boolean"
        },
        "token": {
          "type": "string"
        },
        "type": {
          "description": "The `review_diff` type tag.",
          "enum": [
            "review_diff"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "staged",
        "token",
        "header",
        "hunks",
        "hunk_actions",
        "conflict",
        "binary",
        "bytes"
      ],
      "type": "object"
    },
    "ReviewDiffPage": {
      "description": "The `review.diff_page` reply.",
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "complete": {
          "type": "boolean"
        },
        "conflict": {
          "type": "boolean"
        },
        "header": {
          "type": "string"
        },
        "next_cursor": {
          "description": "The cursor for the next page; null on the last page.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ReviewDiffRow"
          },
          "type": "array"
        },
        "staged": {
          "type": "boolean"
        },
        "token": {
          "type": "string"
        },
        "type": {
          "description": "The `review_diff_page` type tag.",
          "enum": [
            "review_diff_page"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "staged",
        "revision",
        "token",
        "header",
        "rows",
        "next_cursor",
        "complete",
        "binary",
        "conflict",
        "bytes"
      ],
      "type": "object"
    },
    "ReviewDiffPageRequest": {
      "additionalProperties": false,
      "description": "`review.diff_page`: read one bounded page of a file's diff. A first page\nomits `cursor`; a continued page sends the previous `next_cursor`.",
      "properties": {
        "cursor": {
          "type": "string"
        },
        "expected_token": {
          "description": "The token of the first page; a changed diff fails as stale.",
          "type": "string"
        },
        "op": {
          "const": "review.diff_page"
        },
        "path": {
          "type": "string"
        },
        "staged": {
          "type": "boolean"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "path",
        "staged"
      ],
      "type": "object"
    },
    "ReviewDiffRequest": {
      "additionalProperties": false,
      "description": "`review.diff`: read one file's whole diff, split into hunks.",
      "properties": {
        "op": {
          "const": "review.diff"
        },
        "path": {
          "type": "string"
        },
        "staged": {
          "default": false,
          "description": "The staged side; the unstaged side when false or absent.",
          "type": "boolean"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "path"
      ],
      "type": "object"
    },
    "ReviewDiffRow": {
      "description": "One line of a paged diff.",
      "properties": {
        "hunk": {
          "description": "The header of the hunk the line belongs to.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReviewDiffRowKind"
        },
        "new_line": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "old_line": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "The line, cut to 8 KiB.",
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "old_line",
        "new_line",
        "text",
        "hunk",
        "truncated"
      ],
      "type": "object"
    },
    "ReviewDiffRowKind": {
      "description": "What one diff line is.",
      "enum": [
        "hunk",
        "context",
        "added",
        "removed",
        "meta"
      ],
      "type": "string"
    },
    "ReviewDiscardRequest": {
      "additionalProperties": false,
      "description": "`review.discard`: discard one previewed, tracked, unstaged file change.",
      "properties": {
        "diff_token": {
          "description": "The unstaged diff token the user previewed.",
          "type": "string"
        },
        "op": {
          "const": "review.discard"
        },
        "operation_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "workspace_id",
        "operation_id",
        "path",
        "revision",
        "diff_token"
      ],
      "type": "object"
    },
    "ReviewFeedbackMatch": {
      "description": "One message whose review notes match a search.",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "review_feedback": {
          "description": "The matching notes as `ade-review-feedback-v1`."
        }
      },
      "required": [
        "message_id",
        "conversation_id",
        "review_feedback"
      ],
      "type": "object"
    },
    "ReviewFeedbackSearch": {
      "description": "The `review.feedback.search` reply.",
      "properties": {
        "next_cursor": {
          "description": "The cursor for the next page; null on the last page.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ReviewFeedbackMatch"
          },
          "type": "array"
        },
        "type": {
          "description": "The `review_feedback_search` type tag.",
          "enum": [
            "review_feedback_search"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "results",
        "next_cursor"
      ],
      "type": "object"
    },
    "ReviewFeedbackSearchRequest": {
      "additionalProperties": false,
      "description": "`review.feedback.search`: find saved review notes by file, note text or both.",
      "properties": {
        "before": {
          "description": "The `next_cursor` of the previous page.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "limit": {
          "description": "Page size from 1 to 50; the daemon uses 20 when it is absent.",
