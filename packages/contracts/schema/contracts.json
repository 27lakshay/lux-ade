        "conversation_id": {
          "type": "string"
        },
        "op": {
          "const": "draft.get"
        },
        "window_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "conversation_id",
        "window_id"
      ],
      "type": "object"
    },
