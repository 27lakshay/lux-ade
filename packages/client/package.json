{
  "name": "@ade/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test src/sync.test.mjs src/outbox.test.mjs src/remote-state.test.mjs src/placement.test.mjs src/call.test.mjs"
  },
  "dependencies": {
    "@ade/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./outbox": {
      "types": "./dist/outbox.d.ts",
      "default": "./dist/outbox.js"
    }
  }
}
