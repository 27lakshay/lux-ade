{
  "name": "@ade/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test src/catalog.test.mjs src/sync.test.mjs src/outbox.test.mjs src/remote-state.test.mjs src/placement.test.mjs src/call.test.mjs src/request.test.mjs src/git-refusal.test.mjs src/journals.test.mjs src/journal-lock.test.mjs src/worktree-operation.test.mjs"
  },
  "dependencies": {
    "@ade/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./outbox": {
      "types": "./dist/outbox.d.ts",
      "default": "./dist/outbox.js"
    },
    "./journals": {
      "types": "./dist/journals.d.ts",
      "default": "./dist/journals.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test": {
        "cache": false,
        "parallelism": false,
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
