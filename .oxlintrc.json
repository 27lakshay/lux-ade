{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "unicorn", "oxc", "import"],
  // ADE's own rules, each tested in scripts/oxlint-plugin-ade.test.mjs.
  "jsPlugins": [
    "./scripts/oxlint-plugin-ade.mjs",
    { "name": "react-doctor", "specifier": "oxlint-plugin-react-doctor" },
    "@shadcn/lint"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "target/**",
    ".ade/**",
    "packages/contracts/src/generated/**"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/jsx-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/no-object-type-as-default-prop": "error",

    "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }],
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/prefer-ts-expect-error": "error",

    // Terminal and browser code match control characters and split strings into code points on
    // purpose.
    "no-control-regex": "off",
    "typescript/no-misused-spread": "off",
    // Plain sorts here sort strings on purpose. no-base-to-string still catches `${object}`.
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",

    // `const { dropped, ...kept } = value` is how a key is omitted. A leading underscore marks a
    // binding kept for its side effect, such as a Playwright fixture the test needs set up.
    "no-unused-vars": ["error", { "ignoreRestSiblings": true, "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-fallthrough": "error",
    "oxc/no-accumulating-spread": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/error-message": "error"
  },
  "overrides": [
    {
      // Provider and backend execution stays headless: UI contributions load only in the desktop renderer.
      "files": ["packages/provider-sdk/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react/*", "react-dom", "react-dom/*", "electron", "electron/*"],
                "message": "The provider SDK runs headlessly. UI contributions belong to a plugin's ui entry point."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*"],
      "rules": {
        // node:test's test() returns a promise that is meant to float.
        "typescript/no-floating-promises": "off",
        "typescript/no-implied-eval": "off"
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        // Playwright fixtures call `use()` and destructure `{}`; cleanup in finally may throw.
        "react-hooks/rules-of-hooks": "off",
        "no-empty-pattern": "off",
        "no-unsafe-finally": "off",
        "no-unsafe-optional-chaining": "off",
        // Specs stringify caught errors, which are typed unknown.
        "typescript/no-base-to-string": "off"
      }
    },
    {
      // The stock shadcn/ui kit stays unmodified so `shadcn add --overwrite` can update it. These
      // rules report patterns in its upstream code.
      "files": ["apps/desktop/src/renderer/src/components/ui/**", "apps/desktop/src/renderer/src/hooks/use-mobile.ts"],
      "rules": {
        "react/jsx-no-constructed-context-values": "off",
        "react/set-state-in-effect": "off",
        "react/no-object-type-as-default-prop": "off",
        "typescript/no-import-type-side-effects": "off"
      }
    },
    {
      "files": ["apps/desktop/src/main/**"],
      "rules": {
        "ade/electron-web-preferences": "error"
      }
    },
    {
      // IPC goes through the typed helpers, which check the contract (src/shared/ipc.ts) and the sender.
      "files": ["apps/desktop/src/main/**", "apps/desktop/src/preload/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "importNames": ["ipcMain", "ipcRenderer"],
                "message": "Use handle/listen/emit/broadcast from src/main/ipc.ts or invoke/send/subscribe from src/preload/ipc.ts, and add the channel to src/shared/ipc.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/shared/bridge/**"],
      "rules": {
        "ade/no-loose-record": "error"
      }
    },
    {
      "files": ["apps/desktop/src/main/ipc.ts", "apps/desktop/src/preload/ipc.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // The renderer's own code: kit components keep the kit's look (placement may change), colours
      // come from the theme, tooltips come from the kit, and files stay small enough to read whole.
      "files": ["apps/desktop/src/renderer/src/**"],
      "rules": {
        "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
        "shadcn/no-raw-colors": "error",
        "ade/no-native-title": "error",
        "ade/no-layout-double": "error",
        "ade/icons-from-table": "error",
        "ade/icon-size-class": "error",
        "ade/icon-button-label": "error",
        "ade/type-scale": "error",
        "ade/text-elements": "error",
        "ade/surface-steps": "error",
        "ade/spacing-grid": "error",
        "ade/fixed-heights": "error",
        "ade/radius-steps": "error",
        "ade/scroll-area": "error",
        "ade/kit-button-size": "error",
        "ade/button-copy": "error",
        "ade/motion-props": "error",
        "ade/motion-classes": "error",
        "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/**/*.tsx"],
      "rules": {
        "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/**/*.test.*"],
      "rules": {
        "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      // The typography components are where text sizes and weights are set.
      "files": ["apps/desktop/src/renderer/src/components/Typography.tsx"],
      "rules": {
        "ade/type-scale": "off",
        "ade/text-elements": "off"
      }
    },
    {
      // Tests and the bench serve layouts from the layout double, a fake daemon.
      "files": [
        "apps/desktop/src/renderer/src/**/*.test.*",
        "apps/desktop/src/renderer/src/dev/**",
        "apps/desktop/src/renderer/src/features/workspace/testing.tsx"
      ],
      "rules": {
        "ade/no-layout-double": "off"
      }
    },
    {
      // The icon table and <Icon> are where lucide-react is imported.
      "files": ["apps/desktop/src/renderer/src/icons/**"],
      "rules": {
        "ade/icons-from-table": "off"
      }
    },
    {
      // The stock kit, installed and updated by shadcn, is exempt from the renderer's own rules.
      "files": ["apps/desktop/src/renderer/src/components/ui/**", "apps/desktop/src/renderer/src/hooks/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-raw-colors": "off",
        "ade/no-native-title": "off",
        "ade/icons-from-table": "off",
        "ade/icon-size-class": "off",
        "ade/icon-button-label": "off",
        "ade/type-scale": "off",
        "ade/text-elements": "off",
        "ade/surface-steps": "off",
        "ade/spacing-grid": "off",
        "ade/fixed-heights": "off",
        "ade/radius-steps": "off",
        "ade/scroll-area": "off",
        "ade/kit-button-size": "off",
        "ade/button-copy": "off",
        "ade/motion-props": "off",
        "ade/motion-classes": "off",
        "max-lines": "off"
      }
    },
    {
      "files": ["apps/desktop/src/renderer/**"],
      "rules": {
        "ade/require-store-selector": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The renderer is sandboxed. Reach the backend through window.adeHost (see apps/desktop/AGENTS.md)."
              },
              {
                "name": "framer-motion",
                "message": "Motion's package is motion. Import m from motion/react-m, hooks and providers from motion/react."
              },
              {
                "name": "motion/react",
                "importNames": ["motion", "m"],
                "message": "Render m elements: import * as m from 'motion/react-m'. The full motion component bundles every feature (app/MotionProvider.tsx)."
              },
              {
                "name": "motion/react-client",
                "message": "Render m elements: import * as m from 'motion/react-m'."
              },
              {
                "name": "@ade/client",
                "allowTypeImports": true,
                "message": "The SDK's root opens sockets, which the sandboxed renderer cannot. Import types only, or use @ade/client/sync or @ade/client/history."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "The renderer is sandboxed and has no Node. Ask the main process through window.adeHost."
              },
              {
                "group": ["@ade/client/*", "!@ade/client/sync", "!@ade/client/history", "@ade/client/*/*"],
                "caseSensitive": true,
                "allowTypeImports": true,
                "message": "Only @ade/client/sync and @ade/client/history are transport-free; import types only from the rest of the SDK."
              }
            ]
          }
        ]
      }
    }
  ]
}
