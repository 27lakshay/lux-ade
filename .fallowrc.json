{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/desktop/src/main/index.ts",
    "apps/desktop/src/preload/index.ts",
    "apps/desktop/src/stream-bridge/index.ts",
    "apps/desktop/src/renderer/src/main.tsx",
    "apps/desktop/src/renderer/src/dev/*.ts"
  ],
  // The stock shadcn/ui kit: installed whole, used piece by piece, so unused parts are expected.
  "ignoreFindings": [
    "apps/desktop/src/renderer/src/components/ui/**",
    "apps/desktop/src/renderer/src/hooks/**",
    "apps/desktop/src/renderer/src/lib/utils.ts"
  ],
  "ignoreDependencies": [
    // Installed by shadcn for the calendar component's date picker.
    "date-fns",
    // The chosen stack (decision D07), installed ahead of the surfaces that will use it. Remove an
    // entry once something imports the package.
    "@atlaskit/pragmatic-drag-and-drop",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll",
    "@atlaskit/pragmatic-drag-and-drop-hitbox",
    "@pierre/diffs",
    "@tanstack/react-virtual",
    "@tiptap/extension-mention",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/suggestion",
    "shiki",
    "sonner",
    "streamdown",
    "zod",
    "@codemirror/state",
    "@codemirror/view",
    "@pierre/trees",
    "@tanstack/react-hotkeys",
    "@tanstack/react-query",
    "codemirror",
    "electron-context-menu",
    "jsonc-parser",
    "jszip",
    "turndown"
  ],
  "boundaries": {
    "zones": [
      { "name": "desktop-main", "patterns": ["apps/desktop/src/main/**"] },
      { "name": "desktop-preload", "patterns": ["apps/desktop/src/preload/**"] },
      { "name": "desktop-renderer", "patterns": ["apps/desktop/src/renderer/**"] },
      { "name": "desktop-shared", "patterns": ["apps/desktop/src/shared/**"] },
      { "name": "desktop-stream-bridge", "patterns": ["apps/desktop/src/stream-bridge/**"] },
      { "name": "cli", "patterns": ["apps/cli/**"] },
      { "name": "sdk", "patterns": ["packages/client/**"] },
      { "name": "contracts", "patterns": ["packages/contracts/**"] },
      { "name": "terminal", "patterns": ["packages/terminal/**"] },
      { "name": "plugin-host", "patterns": ["packages/plugin-host/**"] }
    ],
    "rules": [
      { "from": "desktop-main", "allow": ["desktop-shared", "sdk", "contracts"] },
      { "from": "desktop-preload", "allow": ["desktop-shared", "terminal"], "allowTypeOnly": ["sdk", "contracts"] },
      // The renderer may use the SDK's transport-free sync module; lint limits it to that module.
      { "from": "desktop-renderer", "allow": ["desktop-shared", "terminal", "sdk"], "allowTypeOnly": ["contracts"] },
      { "from": "desktop-stream-bridge", "allow": ["desktop-shared", "sdk", "contracts"] },
      // Code every process loads: the IPC contract, bridge types, commands, the content policy.
      { "from": "desktop-shared", "allow": [], "allowTypeOnly": ["sdk", "contracts", "terminal"] },
      { "from": "cli", "allow": ["sdk", "contracts"] },
      { "from": "sdk", "allow": ["contracts"] },
      { "from": "terminal", "allow": [] },
      { "from": "contracts", "allow": [] },
      { "from": "plugin-host", "allow": ["sdk", "contracts"] }
    ]
  }
}
